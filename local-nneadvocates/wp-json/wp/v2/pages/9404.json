rid-1-3  unextended\" style=\"padding-top:0px;padding-bottom:0px\" id=\"wpv-column-64d6a8e8bc864d4848dd83755b13f81b\" ><div class=\"services has-more \" id=\"wpv-expandable-6f93d0254f918f52013eb72ee964ae0a\">\n\t<div class=\"closed services-inside\">\n\t\t<div class=\"services-content-wrapper clearfix\">\n\t\t\t\n\t\t\t\t\t\t <div class=\"push\" style='margin-bottom:-60px'><\/div>\n<p style=\"text-align: center;\"><span class='icon shortcode theme inverted-colors use-hover' style='font-size:30px !important;color:#fff;background:#2c57f4;'>&#57422;<\/span>\n<h3 style=\"text-align: center;\"><span class=\"accent-2\">At our company you are a name, not a number!<\/span><\/h3>\n<p style=\"text-align: center;\"><span class=\"accent-1\">EXPEDITIOUS SERVICE<\/span><\/p>\n\n\t\t<\/div>\n\t<\/div>\n\t<div class=\"open services-inside\">\n\t\t<div class=\"services-content-wrapper\">\n\t\t\t<div class=\"row\">\n\t\t\t\t\n<div class=\"push\" style='height:15px'><\/div>\n<p class=\"textcenter\"><a href=\"https:\/\/www.nneadvocates.co.ke\/contact-us\/\" target=\"_self\" style='font-size: 13px;' class=\"button vamtam-button accent1  button-border hover-accent1 \"><span class=\"btext\">GET OUR LAWYER \u2192<\/span><\/a><\/p>\n<div class=\"push\" style='height:15px'><\/div>\n\t\t\t<\/div>\n\t\t<\/div>\n\t<\/div>\n<\/div>\n<style scoped>#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .closed{background-color:#fff;}#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .closed,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .closed p,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .closed .sep-text h2.regular-title-wrapper,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .closed .text-divider-double,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .closed .sep-text .sep-text-line,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .closed .sep,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .closed .sep-2,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .closed .sep-3,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .closed h1,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .closed h2,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .closed h3,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .closed h4,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .closed h5,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .closed h6,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .closed td,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .closed th,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .closed caption{color:#808080;}#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .open{background:#4a4f55;}#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .open,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .open p,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .open .sep-text h2.regular-title-wrapper,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .open .text-divider-double,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .open .sep-text .sep-text-line,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .open .sep,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .open .sep-2,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .open .sep-3,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .open h1,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .open h2,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .open h3,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .open h4,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .open h5,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .open h6,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .open td,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .open th,#wpv-expandable-6f93d0254f918f52013eb72ee964ae0a .open caption{color:#cccfd2;}<\/style>\n<\/div><\/div><\/div><\/div>\n<div class=\"push\" style='height:5px'><\/div>\n\t\t<h2 class=\"text-divider-double\">\t\t\t\nWHAT WE PRACTICE<br \/>\n\t\t<\/h2>\t\t<div class=\"sep\"><\/div>\t\n<div class=\"row \"><div class=\"wpv-grid grid-1-1  wpv-first-level first has-background extended\" style=\"background-color:#4A4F55;padding-top:0px;padding-bottom:0px\" id=\"wpv-column-f217075eaf62cb2136f8c88e4aa0c9be\" ><div class=\"extended-column-inner\"><style>#wpv-column-f217075eaf62cb2136f8c88e4aa0c9be p,#wpv-column-f217075eaf62cb2136f8c88e4aa0c9be em,#wpv-column-f217075eaf62cb2136f8c88e4aa0c9be .column-title,#wpv-column-f217075eaf62cb2136f8c88e4aa0c9be .sep-text h2.regular-title-wrapper,#wpv-column-f217075eaf62cb2136f8c88e4aa0c9be .text-divider-double,#wpv-column-f217075eaf62cb2136f8c88e4aa0c9be .sep-text .sep-text-line,#wpv-column-f217075eaf62cb2136f8c88e4aa0c9be .sep,#wpv-column-f217075eaf62cb2136f8c88e4aa0c9be .sep-2,#wpv-column-f217075eaf62cb2136f8c88e4aa0c9be .sep-3,#wpv-column-f217075eaf62cb2136f8c88e4aa0c9be td,#wpv-column-f217075eaf62cb2136f8c88e4aa0c9be th,#wpv-column-f217075eaf62cb2136f8c88e4aa0c9be caption{color:#cccfd2;}#wpv-column-f217075eaf62cb2136f8c88e4aa0c9be:before{background-color:transparent;}<\/style><div class=\"row \"><div class=\"wpv-grid grid-1-4  first unextended\" style=\"padding-top:0px;padding-bottom:0px\" id=\"wpv-column-f48a208b8518727ab61034d16c4d09e4\" >\n<div  data-href=\"https:\/\/www.nneadvocates.co.ke\/practice-areas\/\" tabindex=\"1\" data-target=\"_self\" class=\"linkarea clearfix accent6  background-accent1\">\n\t\t\t<div class=\"first\"><span class='icon shortcode theme  use-hover' style='font-size:46px !important;color:#ffffff;'>&#57430;<\/span><\/div>\n\t\t\t\t<div class=\"last\"><h3 style=\"text-align: center;\"><span class=\"accent-8\">Family Law<\/span><\/h3>\n<p style=\"text-align: center;\">We handle family matters such as:divorce, legal separation, domestic partnerships, child custody\/visitation, child support, allowance, domestic violence, property distribution.<br \/>\nWe\u2019re able to draw from our prior experience and wealth of knowledge to protect our clients\u2019 best interests throughout the duration of the case.<\/div>\n\t<\/div><\/div>\n<div class=\"wpv-grid grid-1-4  unextended\" style=\"padding-top:0px;padding-bottom:0px\" id=\"wpv-column-31c977cfb4f878ff1cc460f245c7d32f\" >\n<div  data-href=\"https:\/\/www.nneadvocates.co.ke\/practice-areas\/\" tabindex=\"1\" data-target=\"_self\" class=\"linkarea clearfix accent6  background-accent2\">\n\t\t\t<div class=\"first\"><span class='icon shortcode theme  use-hover' style='font-size:46px !important;color:#ffffff;'>&#57430;<\/span><\/div>\n\t\t\t\t<div class=\"last\"><h3 style=\"text-align: center;\"><span class=\"accent-8\">Tax Law<\/span><\/h3>\n<p style=\"text-align: center;\">We advises on various Kenyan tax-related issues including corporation tax, value added tax, withholding tax, compensating tax, excise duty, real estate tax, transfer tax, energy and infrastructure tax, stamp duty, VAT, transfer pricing, corporate restructuring, private equity, income and other\u00a0employment taxes laws.<br \/><\/div>\n\t<\/div><\/div>\n<div class=\"wpv-grid grid-1-4  unextended\" style=\"padding-top:0px;padding-bottom:0px\" id=\"wpv-column-8750d735355aad69a5cb58969de39759\" >\n<div  data-href=\"#\" tabindex=\"1\" data-target=\"_self\" class=\"linkarea clearfix accent2  background-accent1\">\n\t\t\t<div class=\"first\"><span class='icon shortcode theme  use-hover' style='font-size:46px !important;color:#ffffff;'>&#57430;<\/span><\/div>\n\t\t\t\t<div class=\"last\"><h3 style=\"text-align: center;\"><span class=\"accent-8\">Arbitration\u00a0 &#038; Meditation\u00a0<\/span><\/h3>\n<p style=\"text-align: center;\">Arbitration is a widely used means to end disputes. We labour to help our clients resolve disputes efficiently and effectively in a manner that promotes their organizational and personal objectives. Our lawyers have a wealth of experience in resolving disputes (both advocating for clients and sitting as arbitrators).<br \/><\/div>\n\t<\/div><\/div>\n<div class=\"wpv-grid grid-1-4  unextended\" style=\"padding-top:0px;padding-bottom:0px\" id=\"wpv-column-0644afbd9bfdba8fe3c0eae1880d97b6\" >\n<div  data-href=\"https:\/\/www.nneadvocates.co.ke\/practice-areas\/\" tabindex=\"1\" data-target=\"_self\" class=\"linkarea clearfix accent6  background-accent2\">\n\t\t\t<div class=\"first\"><span class='icon shortcode theme  use-hover' style='font-size:46px !important;color:#ffffff;'>&#57430;<\/span><\/div>\n\t\t\t\t<div class=\"last\"><h3 style=\"text-align: center;\"><span class=\"accent-8\">Banking &#038; Finance Law\u00a0\u00a0<\/span><\/h3>\n<p style=\"text-align: center;\">The banking and financial industries are heavily regulated by law. Our lawyers advise on all aspects of banking, insurance and reinsurance law, whether corporate, regulatory or contentious. Our mix of specialist skills and experience has resulted in a industry focused team committed to the highest standards of client service.<br \/><\/div>\n\t<\/div><\/div><\/div>\n<div class=\"row \"><div class=\"wpv-grid grid-1-4  first unextended\" style=\"padding-top:0px;padding-bottom:0px\" id=\"wpv-column-136cc55e4d0327b8d4846fbedd0b3f08\" >\n<div  data-href=\"https:\/\/www.nneadvocates.co.ke\/practice-areas\/\" tabindex=\"1\" data-target=\"_self\" class=\"linkarea clearfix accent6  background-accent2\">\n\t\t\t<div class=\"first\"><span class='icon shortcode theme  use-hover' style='font-size:46px !important;color:#ffffff;'>&#57430;<\/span><\/div>\n\t\t\t\t<div class=\"last\"><h3 style=\"text-align: center;\"><span class=\"accent-8\">Business Setup<\/span><\/h3>\n<p style=\"text-align: center;\">Business setup is an exciting but without the right legal advice it can also be a legal minefield.<\/p>\n<p style=\"text-align: center;\">We provide advice on the regulatory environment for the various types of entities and the sectors within which they operate as well as deal with registration of companies, private public partnerships, business names and trusts.<br \/><\/div>\n\t<\/div><\/div>\n<div class=\"wpv-grid grid-1-4  unextended\" style=\"padding-top:0px;padding-bottom:0px\" id=\"wpv-column-f1169f7a1084caf54a710b6343688c34\" >\n<div  data-href=\"https:\/\/www.nneadvocates.co.ke\/practice-areas\/\" tabindex=\"1\" data-target=\"_self\" class=\"linkarea clearfix accent6  background-accent1\">\n\t\t\t<div class=\"first\"><span class='icon shortcode theme  use-hover' style='font-size:46px !important;color:#ffffff;'>&#57430;<\/span><\/div>\n\t\t\t\t<div class=\"last\"><h3 style=\"text-align: center;\"><span class=\"accent-8\">Constitution &#038; Administrative Law<\/span><\/h3>\n<p style=\"text-align: center;\">The firm has developed excellent expertise in constitutional and administrative law matters particularly in relation to the 2010 Constitution. In this respect, the firm has advised on various provisions on the Constitution especially with regard to the Bill of Rights, Land, Citizenship, Devolved Government and Public Finance.<br \/><\/div>\n\t<\/div><\/div>\n<div class=\"wpv-grid grid-1-4  unextended\" style=\"padding-top:0px;padding-bottom:0px\" id=\"wpv-column-a88b67f17b7485d1cea90c02803a0b58\" >\n<div  data-href=\"https:\/\/www.nneadvocates.co.ke\/practice-areas\/\" tabindex=\"1\" data-target=\"_self\" class=\"linkarea clearfix accent6  background-accent2\">\n\t\t\t<div class=\"first\"><span class='icon shortcode theme  use-hover' style='font-size:46px !important;color:#ffffff;'>&#57430;<\/span><\/div>\n\t\t\t\t<div class=\"last\"><h3 style=\"text-align: center;\"><span class=\"accent-8\">Corporate Law<\/span><\/h3>\n<p style=\"text-align: center;\">Corporate law governs the functioning of companies; from how they are formed to the transactions they are permitted to engage in.<\/p>\n<p style=\"text-align: center;\">It applies to shareholders, directors, creditors and other stakeholders by regulating their rights and duties. It&#8217;s the body of law that regulates legal entities that exist to conduct business.<br \/><\/div>\n\t<\/div><\/div>\n<div class=\"wpv-grid grid-1-4  unextended\" style=\"padding-top:0px;padding-bottom:0px\" id=\"wpv-column-dbc249c2036a266f408f4c274b82e64c\" >\n<div  data-href=\"https:\/\/www.nneadvocates.co.ke\/practice-areas\/\" tabindex=\"1\" data-target=\"_self\" class=\"linkarea clearfix accent6  background-accent1\">\n\t\t\t<div class=\"first\"><span class='icon shortcode theme  use-hover' style='font-size:46px !important;color:#ffffff;'>&#57430;<\/span><\/div>\n\t\t\t\t<div class=\"last\"><h3 style=\"text-align: center;\"><span class=\"accent-8\">Real Estate Law<\/span><\/h3>\n<p style=\"text-align: center;\">This laws deals with all stages of transfer of interests in land including; sales, leases, purchases, charges, tenancy agreements, commercial letting. Our lawyers provide advisory and transactional support in construction, real estate tax, real estate investment and development, real estate partnerships and fractional ownership.<br \/><\/div>\n\t<\/div><\/div><\/div><\/div><\/div><\/div>\n\t\t<h2 class=\"text-divider-double\">\t\t\t\nOUR PHILOSOPHY<br \/>\n\t\t<\/h2>\t\t<div class=\"sep\"><\/div>\t\n<div class=\"row \"><div class=\"wpv-grid grid-1-1  wpv-first-level first unextended animation-from-bottom animated-active\" style=\"padding-top:0px;padding-bottom:0px\" id=\"wpv-column-fb85814b2453007ee0ae2dc960ea76f7\" ><p style=\"text-align: center;\"><span class=\"vamtam-font-style-1 with-color\">\u201cEffective, Efficient and Expeditious Legal Representation&#8221;<\/span><\/p>\n<p style=\"text-align: center;\">\u2014 Nyongesa Nafula &#038; Co. Advocates<\/div><\/div>\n<div class=\"push\" style='height:20px'><\/div>\n<div class=\"row \"><div class=\"wpv-grid grid-1-1  wpv-first-level parallax-bg first has-background extended\" style=\"\n\t\t\t\tbackground: url( 'https:\/\/www.nneadvocates.co.ke\/wp-content\/uploads\/2014\/09\/bg_1.jpg' ) no-repeat center top;\n\t\t\t\tbackground-size: cover;\n\t\t\tbackground-attachment: fixed;padding-top:0px;padding-bottom:50px\" id=\"REQUESTFORM\"  data-parallax-method=\"to-centre\" data-parallax-inertia=\"-0.2\"><div class=\"extended-column-inner\">\t\t<h2 class=\"text-divider-double\">\t\t\t\nREQUEST A FREE CONSULTATION\t\t<\/h2>\t\t<div class=\"sep\"><\/div>\t\n<div class=\"row \"><div class=\"wpv-grid grid-1-1  first unextended\" style=\"padding-top:0px;padding-bottom:0px\" id=\"wpv-column-abea617150ef2ba847b59b5f5db4362c\" ><div class=\"push\" style='margin-bottom:-20px'><\/div>\n<p style=\"text-align: center;\"><span class=\"vamtam-font-style-2 accent-4\">Fill out the form below to receive a free and confidential initial consultation. <\/span><\/p>\n<div class=\"push\" style='height:20px'><\/div><\/div><\/div>\n<div class=\"row \"><div class=\"wpv-grid grid-1-1  first unextended\" style=\"padding-top:0px;padding-bottom:0px\" id=\"wpv-column-f761da2ac6244df2799a455af4f5dad1\" ><div class=\"wpcf7 no-js\" id=\"wpcf7-f9392-o1\" lang=\"\" dir=\"ltr\" data-wpcf7-id=\"9392\">\n<div class=\"screen-reader-response\"><p role=\"status\" aria-live=\"polite\" aria-atomic=\"true\"><\/p> <ul><\/ul><\/div>\n<form action=\"\/wp-json\/wp\/v2\/pages\/9404#wpcf7-f9392-o1\" method=\"post\" class=\"wpcf7-form init\" aria-label=\"Contact form\" novalidate=\"novalidate\" data-status=\"init\">\n<fieldset class=\"hidden-fields-container\"><input type=\"hidden\" name=\"_wpcf7\" value=\"9392\" \/><input type=\"hidden\" name=\"_wpcf7_version\" value=\"6.2.5\" \/><input type=\"hidden\" name=\"_wpcf7_locale\" value=\"\" \/><input type=\"hidden\" name=\"_wpcf7_unit_tag\" value=\"wpcf7-f9392-o1\" \/><input type=\"hidden\" name=\"_wpcf7_container_post\" value=\"0\" \/><input type=\"hidden\" name=\"_wpcf7_posted_data_hash\" value=\"\" \/>\n<\/fieldset>\n<div class=\"wpcf7-response-output\" aria-hidden=\"true\"><\/div>\n<\/form>\n<\/div>\n<\/div><\/div><\/div><\/div><\/div>\n<div class=\"row \"><div class=\"wpv-grid grid-1-1  wpv-first-level first unextended\" style=\"padding-top:0px;padding-bottom:0px\" id=\"wpv-column-25a069f8de6ed7656f44aa8b454e0fd5\" ><p>ngg_shortcode_0_placeholder<\/div><\/div>\n","protected":false},"excerpt":{"rendered":"<p>\u201cEffe